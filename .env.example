# -----------------------------------------------------------------------------
# Live MahaRERA lookup configuration
# -----------------------------------------------------------------------------
# All variables are OPTIONAL. With none set, the app fetches the MahaRERA portal
# directly. Because the portal blocks datacenter/bot traffic (403 + captcha),
# direct fetches often fail from serverless hosts (Vercel etc.) — set
# MAHARERA_PROXY_URL to route through a scraping proxy that presents residential
# IPs and solves captchas.

# Scraping-proxy URL. Two accepted shapes:
#   1. Placeholder — put {url} where the encoded target goes:
#        MAHARERA_PROXY_URL=https://api.scrapingbee.com/?api_key=YOUR_KEY&render_js=false&url={url}
#   2. Prefix — no placeholder; the encoded target is appended:
#        MAHARERA_PROXY_URL=https://api.scraperapi.com/?api_key=YOUR_KEY&url=
# MAHARERA_PROXY_URL=

# Portal base origin (default: https://maharera.maharashtra.gov.in)
# MAHARERA_BASE_URL=

# Search results path on the portal (default: /projects-search-result)
# MAHARERA_SEARCH_PATH=

# Per-request timeout in ms (default: 12000)
# MAHARERA_TIMEOUT_MS=

# Cache TTL for successful live lookups, in ms (default: 21600000 = 6h)
# MAHARERA_CACHE_TTL_MS=

# Master switch. Set to "false" to skip the network and serve seed data only.
# MAHARERA_LIVE_ENABLED=true
